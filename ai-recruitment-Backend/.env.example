# Application
APP_NAME="AI Recruitment Intelligence Platform"
APP_VERSION="1.0.0"
DEBUG=false
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars

# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/ai_recruitment
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# AI Provider (openai | groq | ollama)
AI_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Groq (alternative)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama3-70b-8192

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# FAISS
FAISS_INDEX_PATH=./vector_store/faiss_index
EMBEDDING_DIMENSION=1536

# Auth
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# OAuth (Get credentials from Google Cloud Console & Azure Portal)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Transactional email (Resend HTTP API, no SMTP)
# Verify your sending domain in Resend before emailing candidates.
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=interviews@your-verified-domain.com
FROM_NAME=TalentIQ
# Used by an external five-minute cron POST to /api/v1/interviews/reminders/process
REMINDER_CRON_SECRET=replace-with-a-long-random-secret

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
