# TalentIQ Interview OS — Environment Configuration
# Copy this file to .env and fill in your values

# ─── Server ───
PORT=3000
NODE_ENV=production

# ─── Your deployed URL on Render ───
# Set this to your Render service URL, e.g.:
# BASE_URL=https://talentiq-interview.onrender.com
BASE_URL=http://localhost:3000

# ─── CORS: comma-separated list of allowed origins ───
# Add your recruitment portal's domain here
# ALLOWED_ORIGINS=https://yourportal.onrender.com,https://yourportal.com
ALLOWED_ORIGINS=*

# ─── Optional API Key for room creation endpoint ───
# If set, your portal must pass this as apiKey in POST /api/rooms/create
# TALENTIQ_API_KEY=your-secret-key-here
TALENTIQ_API_KEY=

# ─── Anthropic API Key for AI analysis ───
# The AI Copilot calls the Anthropic API from the recruiter's browser
# This key is used client-side in the browser (recruiter only)
# Alternatively, proxy through your server for security
ANTHROPIC_API_KEY=
